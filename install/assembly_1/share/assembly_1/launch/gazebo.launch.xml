<launch>
  <!-- 1. Define Paths -->
  <let name="pkg_share" value="$(find-pkg-share assembly_1)"/>
  <let name="world_path" value="$(var pkg_share)/world/rice_field.sdf"/>
  <let name="xacro_file" value="$(var pkg_share)/urdf/assembly_1.urdf.xacro"/>

  <!-- 2. Set Environment Variable for Mesh Resource Finding -->
  <set_env name="GZ_SIM_RESOURCE_PATH" value="$(var pkg_share):$(var pkg_share)/.."/>

  <!-- 3. Launch Gazebo Sim with Rice Field World -->
  <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
    <arg name="gz_args" value="-r $(var world_path)"/>
  </include>

  <!-- 4. Publish Robot State from Xacro -->
  <node pkg="robot_state_publisher" exec="robot_state_publisher" output="screen">
    <param name="robot_description" value="$(command 'xacro $(var xacro_file)')"/>
    <param name="use_sim_time" value="true"/>
  </node>

  <!-- 5. Spawn Drone Entity into Gazebo from the generated URDF -->
  <node pkg="ros_gz_sim" exec="create" output="screen"
        args="-string $(command 'xacro $(var xacro_file)') -name drone -x 0 -y 0 -z 2.0"/>

  <!-- 6. Bridge Simulation Clock to ROS 2 -->
  <node pkg="ros_gz_bridge" exec="parameter_bridge" output="screen"
        args="/clock@rosgraph_msgs/msg/Clock[gz.msgs.Clock]"/>

  <node pkg="ros_gz_bridge" exec="parameter_bridge" name="parameter_bridge">
    <param name="config_file" value="$(find-pkg-share assembly_1)/config/controller.yaml"/>
  </node>
</launch>