<?xml version="1.0" ?>
<robot name="assembly_1">
  <link name="base_link">
    <inertial>
      <mass value="1.0"/>
      <origin rpy="0 -0 0" xyz="0 0 0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
    <visual>
      <origin rpy="0 -0 0" xyz="0.00908956 0.0132281 -0.0575308"/>
      <geometry>
        <mesh filename="package://assembly_1/meshes/Default.stl" scale="1 1 1"/>
      </geometry>
      <material name="0.501961_1.000000_0.501961_0.000000_0.000000">
        <color rgba="0.501961 1 0.501961 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 -0 0" xyz="0.00908956 0.0132281 -0.0575308"/>
      <geometry>
        <mesh filename="package://assembly_1/meshes/Default.stl" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>
  <joint name="gps_joint" type="fixed">
    <!-- the base of the drone or the component that the gps link attched to -->
    <parent link="base_link"/>
    <!-- the gps link  -->
    <child link="gps"/>
    <origin rpy="0 0 0" xyz="0.3 0.3 0.3"/>
  </joint>
  <link name="gps">
    <visual>
      <geometry>
        <!-- the box around the drone -->
        <box size="0.03 0.03 0.01"/>
      </geometry>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <!--//rpy rotation ;row, ptich , yaw  -->
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>
  <gazebo reference="gps">
    <sensor name="navsat_sensor" type="navsat">
      <always_on>1</always_on>
      <update_rate>10</update_rate>
      <topic>navsat</topic>
    </sensor>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
  </gazebo>
  <joint name="imu_joint" type="fixed">
    <child link="imu_link"/>
    <parent link="base_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <link name="imu_link">
    <visual>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>1</always_on>
      <update_rate>100</update_rate>
      <visualize>true</visualize>
      <topic>imu</topic>
    </sensor>
  </gazebo>
  <gazebo>
    <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu"/>
  </gazebo>
  <joint name="downward_camera_joint" type="fixed">
    <origin rpy="0.0 1.5708 0.0" xyz="0.1 0.0 -0.05"/>
    <parent link="base_link"/>
    <child link="camera_link"/>
  </joint>
  <link name="camera_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.03"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.03"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>
  <gazebo reference="camera_link">
    <sensor name="downward_camera" type="camera">
      <update_rate>30.0</update_rate>
      <topic>camera/image_raw</topic>
      <pose>0 0 0 0 0 0</pose>
      <camera name="intel_cam">
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>300</far>
        </clip>
      </camera>
      <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"/>
    </sensor>
  </gazebo>
</robot>
