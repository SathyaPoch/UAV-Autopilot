<?xml version="1.0"?>

<sdf version="1.9">
  <model name="assembly_1">
    <link name="base_link">
      <inertial>

        <pose>
          0.0074766355140186919
          0.00280373831775701
          0.00046728971962616781
          0 0 0
        </pose>

        <mass>1.0700000000000001</mass>

        <inertia>
          <ixx>0.1020363551401869</ixx>
          <ixy>-0.0008775700934579439</ixy>
          <ixz>-0.00064626168224299059</ixz>

          <iyy>0.10248495327102811</iyy>
          <iyz>-0.00089859813084112148</iyz>

          <izz>0.10235177570093459</izz>
        </inertia>

      </inertial>

      <collision name="root_collision">

        <pose>
          0.00908956 0.0132281 -0.0575308
          0 0 0
        </pose>

        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://assembly_1/meshes/Default.stl</uri>
          </mesh>
        </geometry>

      </collision>


      <collision name="root_fixed_joint_lump__camera_link_collision_1">

        <pose>
          0 0 -0.05
          0 1.5707963267948966 0
        </pose>

        <geometry>
          <box>
            <size>0.03 0.03 0.03</size>
          </box>
        </geometry>

        <surface>

          <contact>
            <ode/>
          </contact>

          <friction>
            <ode/>
          </friction>

        </surface>

      </collision>
      <visual name="root_visual">

        <pose>
          0.00908956 0.0132281 -0.0575308
          0 0 0
        </pose>

        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://assembly_1/meshes/Default.stl</uri>
          </mesh>
        </geometry>

        <material>
          <diffuse>0.627451241 1 0.627451241 1</diffuse>
          <ambient>0.627451241 1 0.627451241 1</ambient>
        </material>

      </visual>

      <visual name="root_fixed_joint_lump__camera_link_visual_1">

        <pose>
          0.1 0 -0.05
          0 1.5707963267948966 0
        </pose>

        <geometry>
          <box>
            <size>0.03 0.03 0.03</size>
          </box>
        </geometry>

      </visual>

      <visual name="root_fixed_joint_lump__gps_visual_2">

        <pose>
          0.3 0.3 0.3
          0 0 0
        </pose>

        <geometry>
          <box>
            <size>0.03 0.03 0.01</size>
          </box>
        </geometry>

      </visual>

      <visual name="root_fixed_joint_lump__imu_link_visual_3">

        <pose>0 0 0 0 0 0</pose>

        <geometry>
          <box>
            <size>0.02 0.02 0.02</size>
          </box>
        </geometry>

      </visual>
      <sensor name="downward_camera" type="camera">

        <always_on>true</always_on>

        <update_rate>30</update_rate>

        <topic>/camera/image_raw</topic>

        <pose>
          0.1 0 -0.05
          3.141592653589793
          1.5707926536359933
          3.141592653589793
        </pose>

        <camera name="intel_cam">

          <horizontal_fov>1.3962634</horizontal_fov>

          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>

          <clip>
            <near>0.02</near>
            <far>300</far>
          </clip>

        </camera>

      </sensor>

      <sensor name="gps_sensor" type="navsat">

        <always_on>true</always_on>

        <update_rate>10</update_rate>

        <topic>/navsat</topic>

        <pose>
          0.3 0.3 0.3
          0 0 0
        </pose>

      </sensor>

      <sensor name="imu_sensor" type="imu">

        <always_on>true</always_on>

        <update_rate>100</update_rate>

        <topic>/imu</topic>

        <visualize>true</visualize>

        <pose>0 0 0 0 0 0</pose>

      </sensor>


    </link>

    <plugin
      filename="gz-sim-navsat-system"
      name="gz::sim::systems::NavSat">
    </plugin>


    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">

      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>

    <plugin
      filename="libgz_mavlink_pin_bridge.so"
      name="gz::sim::systems::MavlinkPinBridge">

      <!-- PX4 / autopilot connection -->
      <fcu_addr>127.0.0.1</fcu_addr>

      <fcu_udp_port>14560</fcu_udp_port>

      <connection_type>udp</connection_type>

      <imu_topic>/imu</imu_topic>

      <gps_topic>/navsat</gps_topic>
      <actuator_sub_topic>
        /model/assembly_1/command/motor_speed
      </actuator_sub_topic>

    </plugin>
    <frame
      name="downward_camera_joint"
      attached_to="base_link">

      <pose>
        0.1 0 -0.05
        3.141592653589793
        1.5707926536359933
        3.141592653589793
      </pose>

    </frame>


    <frame
      name="camera_link"
      attached_to="downward_camera_joint">
      <pose>0 0 0 0 0 0</pose>
    </frame>
    <frame
      name="gps_joint"
      attached_to="base_link">
      <pose>
        0.3 0.3 0.3
        0 0 0
      </pose>
    </frame>
    <frame
      name="gps"
      attached_to="gps_joint">
      <pose>0 0 0 0 0 0</pose>
    </frame>
    <frame
      name="imu_joint"
      attached_to="base_link">
      <pose>0 0 0 0 0 0</pose>
    </frame>
    <frame
      name="imu_link"
      attached_to="imu_joint">
      <pose>0 0 0 0 0 0</pose>
    </frame>
  </model>
</sdf>