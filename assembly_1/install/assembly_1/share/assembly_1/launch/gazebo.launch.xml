<launch>
 
  <let name="pkg_share" value="$(find-pkg-share assembly_1)"/>

  <let name="world_path"
       value="$(var pkg_share)/world/rice_field.sdf"/>

  <let name="model_path"
       value="$(var pkg_share)/urdf/assembly_1.sdf"/>
  <set_env name="GZ_SIM_RESOURCE_PATH"
           value="$(var pkg_share)/..:$(var pkg_share)"/>
  <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">

    <arg name="gz_args"
         value="-r $(var world_path)"/>
  </include>

  <node pkg="ros_gz_sim"
        exec="create"
        output="screen"
        args="-file $(var model_path)
              -name assembly_1
              -x 0
              -y 0
              -z 2.0"/>
  <node pkg="ros_gz_bridge"
        exec="parameter_bridge"
        output="screen"
        args="/clock@rosgraph_msgs/msg/Clock[gz.msgs.Clock]"/>

  <node pkg="ros_gz_bridge"
        exec="parameter_bridge"
        name="parameter_bridge"
        output="screen">
    <param name="config_file"
           value="$(var pkg_share)/config/controller.yaml"/>
  </node>

</launch>