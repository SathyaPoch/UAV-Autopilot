<?xml version="1.0"?>
<sdf version="1.9">

  <world name="rice_field">
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <scene>
      <ambient>0.6 0.6 0.6 1.0</ambient>
      <background>0.8 0.9 1.0 1.0</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 50 0 0 0</pose>
      <diffuse>0.95 0.95 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.3 0.2 -1.0</direction>
    </light>

    <model name="terrain_base">
      <static>true</static>
      
      <!-- // soil 120X120m -->
      <link name="base_soil">
        <collision name="ground_col">
          <geometry>
            <box><size>120 120 0.2</size></box>
          </geometry>
        </collision>
        <visual name="ground_vis">
          <geometry>
            <box><size>120 120 0.2</size></box>
          </geometry>
          <material>
            <ambient>0.25 0.18 0.12 1</ambient>
            <diffuse>0.35 0.24 0.15 1</diffuse>
            <roughness>0.9</roughness>
          </material>
        </visual>
      </link>

      <!-- Raised Dirt Bunds & Canal Banks -->
      <link name="bunds_and_banks">
        <!-- Canal Left Bank (Continuous Along Y-axis) -->
        <visual name="canal_bank_left">
          <pose>-2.2 0 0.16 0 0 0</pose>
          <geometry><box><size>1.4 120 0.32</size></box></geometry>
          <material>
            <ambient>0.32 0.24 0.16 1</ambient>
            <diffuse>0.42 0.32 0.22 1</diffuse>
          </material>
        </visual>

        <!-- Canal Right Bank (Continuous Along Y-axis) -->
        <visual name="canal_bank_right">
          <pose>2.2 0 0.16 0 0 0</pose>
          <geometry><box><size>1.4 120 0.32</size></box></geometry>
          <material>
            <ambient>0.32 0.24 0.16 1</ambient>
            <diffuse>0.42 0.32 0.22 1</diffuse>
          </material>
        </visual>

        <!-- North Horizontal Dividers (Separated: Left and Right of Canal) -->
        <visual name="bund_h1_left">
          <pose>-31.45 30 0.15 0 0 0</pose>
          <geometry><box><size>57.1 1.0 0.3</size></box></geometry>
          <material>
            <ambient>0.3 0.22 0.14 1</ambient>
            <diffuse>0.4 0.3 0.2 1</diffuse>
          </material>
        </visual>

        <visual name="bund_h1_right">
          <pose>31.45 30 0.15 0 0 0</pose>
          <geometry><box><size>57.1 1.0 0.3</size></box></geometry>
          <material>
            <ambient>0.3 0.22 0.14 1</ambient>
            <diffuse>0.4 0.3 0.2 1</diffuse>
          </material>
        </visual>

        <visual name="bund_h2_left">
          <pose>-31.45 -30 0.15 0 0 0</pose>
          <geometry><box><size>57.1 1.0 0.3</size></box></geometry>
          <material>
            <ambient>0.3 0.22 0.14 1</ambient>
            <diffuse>0.4 0.3 0.2 1</diffuse>
          </material>
        </visual>

        <visual name="bund_h2_right">
          <pose>31.45 -30 0.15 0 0 0</pose>
          <geometry><box><size>57.1 1.0 0.3</size></box></geometry>
          <material>
            <ambient>0.3 0.22 0.14 1</ambient>
            <diffuse>0.4 0.3 0.2 1</diffuse>
          </material>
        </visual>

        <!-- Longitudinal Outer Field Dividers -->
        <visual name="bund_v_left">
          <pose>-32 0 0.15 0 0 0</pose>
          <geometry><box><size>1.0 120 0.3</size></box></geometry>
          <material>
            <ambient>0.3 0.22 0.14 1</ambient>
            <diffuse>0.4 0.3 0.2 1</diffuse>
          </material>
        </visual>

        <visual name="bund_right">
          <pose>32 0 0.15 0 0 0</pose>
          <geometry><box><size>1.0 120 0.3</size></box></geometry>
          <material>
            <ambient>0.3 0.22 0.14 1</ambient>
            <diffuse>0.4 0.3 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="canal">
      <static>true</static>
      <pose>0 0 0.03 0 0 0</pose>
      <link name="water_link">
        <visual name="water_vis">
          <geometry>
            <box><size>3.0 120 0.08</size></box>
          </geometry>
          <material>
            <ambient>0.15 0.42 0.35 0.95</ambient>
            <diffuse>0.20 0.52 0.45 0.95</diffuse>
            <specular>0.85 0.85 0.85 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Lush Green Rice Fields -->
    <model name="green_rice_fields">
      <static>true</static>
      <link name="fields">
        <!-- Inner Left Fields bordering Canal -->
        <visual name="rice_inner_left_north">
          <pose>-17.5 15 0.15 0 0 0</pose>
          <geometry><box><size>28 29 0.1</size></box></geometry>
          <material>
            <ambient>0.2 0.65 0.15 1</ambient>
            <diffuse>0.28 0.85 0.2 1</diffuse>
          </material>
        </visual>

        <visual name="rice_inner_left_south">
          <pose>-17.5 -45 0.15 0 0 0</pose>
          <geometry><box><size>28 29 0.1</size></box></geometry>
          <material>
            <ambient>0.18 0.6 0.14 1</ambient>
            <diffuse>0.25 0.8 0.18 1</diffuse>S
          </material>
        </visual>

        <!-- Inner Right Fields bordering Canal -->
        <visual name="rice_inner_right_north">
          <pose>17.5 45 0.15 0 0 0</pose>
          <geometry><box><size>28 29 0.1</size></box></geometry>
          <material>
            <ambient>0.2 0.65 0.15 1</ambient>
            <diffuse>0.28 0.85 0.2 1</diffuse>
          </material>
        </visual>

        <visual name="rice_inner_right_mid">
          <pose>17.5 -15 0.15 0 0 0</pose>
          <geometry><box><size>28 29 0.1</size></box></geometry>
          <material>
            <ambient>0.22 0.7 0.18 1</ambient>
            <diffuse>0.3 0.88 0.22 1</diffuse>
          </material>
        </visual>

        <!-- Outer Lateral Fields -->
        <visual name="rice_outer_far_left">
          <pose>-46 0 0.15 0 0 0</pose>
          <geometry><box><size>27 59 0.1</size></box></geometry>
          <material>
            <ambient>0.19 0.62 0.16 1</ambient>
            <diffuse>0.26 0.82 0.2 1</diffuse>
          </material>
        </visual>

        <visual name="rice_outer_far_right_south">
          <pose>46 -30 0.15 0 0 0</pose>
          <geometry><box><size>27 59 0.1</size></box></geometry>
          <material>
            <ambient>0.2 0.65 0.15 1</ambient>
            <diffuse>0.28 0.85 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    //soil
    <model name="bare_soil_plots">
      <static>true</static>
      <link name="plots">
        <visual name="bare_inner_left_mid">
          <pose>-17.5 -15 0.11 0 0 0</pose>
          <geometry><box><size>28 29 0.05</size></box></geometry>
          <material>
            <ambient>0.28 0.2 0.13 1</ambient>
            <diffuse>0.38 0.28 0.18 1</diffuse>
          </material>
        </visual>

        <visual name="bare_inner_left_north_far">
          <pose>-17.5 45 0.11 0 0 0</pose>
          <geometry><box><size>28 29 0.05</size></box></geometry>
          <material>
            <ambient>0.24 0.18 0.12 1</ambient>
            <diffuse>0.34 0.25 0.16 1</diffuse>
          </material>
        </visual>

        <visual name="bare_inner_right_south">
          <pose>17.5 -45 0.11 0 0 0</pose>
          <geometry><box><size>28 29 0.05</size></box></geometry>
          <material>
            <ambient>0.26 0.19 0.12 1</ambient>
            <diffuse>0.36 0.26 0.17 1</diffuse>
          </material>
        </visual>

        <visual name="bare_outer_far_right_north">
          <pose>46 30 0.11 0 0 0</pose>
          <geometry><box><size>27 59 0.05</size></box></geometry>
          <material>
            <ambient>0.28 0.2 0.13 1</ambient>
            <diffuse>0.38 0.28 0.18 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>