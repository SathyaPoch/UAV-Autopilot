      <sensor name='downward_camera' type='camera'>
        <update_rate>30</update_rate>
        <topic>camera/image_raw</topic>
        <camera name='intel_cam'>
          <horizontal_fov>1.3962634</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.02</near>
            <far>300</far>
          </clip>
        </camera>
       
        <pose>0.10000000000000001 0 -0.050000000000000003 3.1415926535897931 1.5707926536359933 3.1415926535897931</pose>
      </sensor>
      <sensor name='gps_sensor' type='navsat'>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <pose>0.29999999999999999 0.29999999999999999 0.29999999999999999 0 0 0</pose>
        <gps/>
      </sensor>
      <sensor name='imu_sensor' type='imu'>
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <visualize>true</visualize>
